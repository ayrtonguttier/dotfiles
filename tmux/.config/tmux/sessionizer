#!/usr/bin/env bash

#preview_cmd='readme=$(find -L {} -maxdepth 1 -iname "README*" -type f | head -n1); if [[ -n "$readme" ]]; then bat --style=plain --color=always --language=markdown "$readme"; else echo "{}"; fi'

if [[ $# -eq 1 ]]; then
    selected=$1
else
    #selected=$(find ~/.config ~/projects ~/personal  -mindepth 1 -maxdepth 1 -type d | fzf --preview "$preview_cmd")
    selected=$(find ~/projects/ ~/personal/ ~/.config/ -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

session_name=$(basename $selected | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]] ; then
    tmux new-session -c $selected -s $session_name -e SESSION_HOME=$selected
    exit 0
fi

if ! tmux has-session -t $session_name 2>/dev/null; then
    tmux new-session -c $selected -ds $session_name -e SESSION_HOME=$selected
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t $session_name
else
    tmux switch-client -t $session_name
fi
